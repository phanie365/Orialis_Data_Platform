# ---------------------------------------------------------------------------
# Orialis ERP frontend - environment template
# ---------------------------------------------------------------------------
#
# Copy to `.env` in this directory (ERP/frontend/.env). Both variables are read
# by vite.config.js, in Node, and NEVER reach the browser.
#
# Neither is prefixed with VITE_: a VITE_ variable is inlined into the
# JavaScript bundle and published to every visitor. vite.config.js refuses to
# start if a VITE_ variable looks like a secret.

# Where the ERP API listens. Locally: uvicorn ERP.app.main:app --port 8001
ERP_API_URL=http://127.0.0.1:8001

# The same value as ERP_API_KEY in the repository-root .env read by the API.
# Attached server-side, by the Vite proxy, as the X-API-Key header.
# It is NOT the CRM key.
ERP_API_KEY=
