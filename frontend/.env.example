# ---------------------------------------------------------------------------
# Orialis CRM frontend - environment template
# ---------------------------------------------------------------------------
#
# Copy to `.env` in this directory and fill in your own values:
#
#     cp .env.example .env
#
# The SAME two variables drive both environments, with different values and
# read by different code:
#
#     development   vite.config.js   reads them in Node, proxies :5173 -> API
#     production    server.js        reads them in Node, proxies :$PORT -> API
#
# On Render they are not a file at all: they are set in the service's
# Environment tab and reach the container as real environment variables. This
# file is never deployed - see frontend/.dockerignore, which excludes every
# `.env` from the build context.
#
# ---------------------------------------------------------------------------
# WHY NEITHER VARIABLE IS PREFIXED WITH VITE_
# ---------------------------------------------------------------------------
#
# Vite exposes a variable to client code ONLY when its name starts with
# `VITE_`. Such a variable is substituted into the JavaScript bundle at build
# time: `import.meta.env.VITE_X` literally becomes its value in a file served
# to every visitor. Anyone can read it with "View source".
#
# A secret can therefore never be a `VITE_` variable. Not because the .env is
# committed - it is not - but because the value ends up in the build output.
#
# Both variables below are intentionally UNPREFIXED. They are read by
# vite.config.js in development and by server.js in production, both of which
# run in Node, on a server. React never sees them, and Vite will refuse to
# expose them even by mistake.
#
# This holds on Render too, and it is worth stating plainly because the
# dashboard makes the mistake easy: adding a variable named
# `VITE_CRM_API_KEY` there would inline the key into the bundle during
# `npm run build` inside the image, and publish it to every visitor. The
# variable is called CRM_API_KEY. No prefix. Ever.
#
# ---------------------------------------------------------------------------
# CRM_API_URL
# ---------------------------------------------------------------------------
#
# Where the FastAPI CRM API is listening. Every browser request for `/api/...`
# is proxied to this address by whichever Node layer is running.
#
# Defaults to http://127.0.0.1:8000 when left unset.
#
# A trailing slash is tolerated - server.js strips it - but the canonical
# form is without one:
#
#     local       CRM_API_URL=http://127.0.0.1:8000
#     Render      CRM_API_URL=https://orialis-data-platform.onrender.com

CRM_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# CRM_API_KEY
# ---------------------------------------------------------------------------
#
# The same key as `CRM_API_KEY` in the repository-root `.env` that the API
# itself reads. The Node layer attaches it as the `X-API-Key` header on each
# proxied request, on its way out to FastAPI.
#
# It MUST be byte-identical to the value configured on the API service.
# A mismatch is not a subtle failure: every proxied call returns 401 and the
# dashboard shows "the CRM API rejected the request".
#
# Without it the API answers 401 and the dashboard shows an error. Neither
# the dev server nor server.js ever logs its value - both report only whether
# it is set.
#
# On Render: mark this one as a SECRET.

CRM_API_KEY=

# ---------------------------------------------------------------------------
# PORT  (production only - do not set it here)
# ---------------------------------------------------------------------------
#
# server.js listens on 0.0.0.0:$PORT. Render injects this variable itself and
# routes external traffic to it, so it must NOT be set manually in the Render
# dashboard. When absent - `npm start`, or a local `docker run` - server.js
# falls back to 8080.
#
# It is listed here for documentation only, deliberately left commented out.
#
# PORT=8080

# ---------------------------------------------------------------------------
# What must NEVER appear in this file
# ---------------------------------------------------------------------------
#
# - DATABASE_URL, or any part of it. The frontend has no database access and
#   never will: every figure it displays comes from the CRM API.
# - Any Supabase host, project reference, password or service key.
# - Any variable prefixed with VITE_ that is not safe to publish.
